  dim4 - {descriptive} dim4Name;
};
dimension dim5 {
  dim5 - dim5Level1 - dim5Level2;
  dim5 - {descriptive} dim5Name;
};
dimension dim6 {
  dim6 - dim6Level1 - dim6Level2;
  dim6 - {descriptive} dim6Name;
};
Measurement - dim1;
